{
  "name": "@escalated-dev/escalated-nestjs",
  "version": "1.2.15",
  "description": "Embedded helpdesk module for NestJS applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "assets",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:package": "node scripts/verify-installed-package.cjs",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.cjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/escalated-dev/escalated-nestjs.git"
  },
  "keywords": [
    "nestjs",
    "helpdesk",
    "ticketing",
    "support",
    "sla"
  ],
  "author": "Escalated Dev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/escalated-dev/escalated-nestjs/issues"
  },
  "homepage": "https://github.com/escalated-dev/escalated-nestjs#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "@nestjs/typeorm": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "typeorm": "^0.3.0",
    "express-session": "^1.17.0"
  },
  "peerDependenciesMeta": {
    "express-session": {
      "optional": true
    }
  },
  "dependencies": {
    "@escalated-dev/locale": "^0.1.8",
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.9",
    "@xmldom/xmldom": "^0.9.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "handlebars": "^4.7.10",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "markdown-it": "^15.0.3",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^10.3.1",
    "otpauth": "^9.6.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "simple-oauth2": "^5.1.0",
    "uuid": "^11.1.1",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@nestjs/typeorm": "^11.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/simple-oauth2": "^5.0.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.14.0",
    "express-session": "^1.19.0",
    "jest": "^30.5.2",
    "jest-util": "^30.5.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "rxjs": "^7.8.2",
    "socket.io-client": "4.8.4",
    "ts-jest": "^29.4.15",
    "typeorm": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "preview-email": {
      "uuid": "^11.1.1"
    }
  }
}
